# ─── Anthropic (required) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Business identity ─────────────────────────────────────────────────────
# No real brand name exists yet — this is read into every persona prompt.
# Set it once a name is picked; until then everything runs under the
# placeholder that's obviously a placeholder on purpose.
BUSINESS_NAME=

# ─── Vizard (clip-detection API — docs.vizard.ai) ──────────────────────────
VIZARD_API_KEY=

# ─── Stripe (invoicing/payments — Josh creates this account himself: identity
# + bank verification is a real login/money step, not the agent's to do) ────
STRIPE_SECRET_KEY=

# ─── Resend (outbound email — resend.com, needs a verified sending domain) ──
RESEND_API_KEY=
EMAIL_FROM=

# ─── TikTok Content Posting API (OPTIONAL — only if Josh wants a demo-reel/
# portfolio channel; the business model itself does not depend on this) ─────
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_CONTENT_ACCESS_TOKEN=

# ─── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PASSWORD=

# ─── Railway (auto-set, leave blank locally) ──────────────────────────────────
PORT=3000

# ─── Awon behavior ────────────────────────────────────────────────────────────
# How often Awon runs a full cycle (cron syntax — default every 8 hours)
CYCLE_CRON=0 */8 * * *

# Starting budget Awon can work with for tool costs (Vizard/email volume) — USD
STARTING_BUDGET_USD=50
